# generated by make-conf.sh — profile: pq
worker_processes auto;
worker_rlimit_nofile 65536;
pid /opt/nginx/logs/nginx.pid;
error_log /opt/nginx/logs/error.log notice;

events {
    worker_connections 16384;
}

http {
    log_format bench '$msec $pid $connection $ssl_protocol $ssl_curve $status $request_time';
    access_log /opt/nginx/logs/bench.log bench buffer=256k flush=1s;

    server {
        listen 443 ssl reuseport backlog=16384;
        server_name _;

        ssl_certificate     /opt/nginx/conf/certs/ecdsa.crt;
        ssl_certificate_key /opt/nginx/conf/certs/ecdsa.key;
        ssl_protocols       TLSv1.3;
        ssl_ecdh_curve      X25519MLKEM768:X25519:prime256v1;
        ssl_session_cache   off;
        ssl_session_tickets off;

        location / {
            add_header X-Worker-Pid $pid always;
            return 200 "ok\n";
        }
    }
}
